<?xml version="1.0" encoding="utf-8"?>
<!-- Only window changes (to re-check the lock screen), no content events and no
     access to window content. isAccessibilityTool: the bar is a navigation aid
     for people who cannot use the small system buttons or gestures. -->
<accessibility-service xmlns:android="http://schemas.android.com/apk/res/android"
    android:accessibilityEventTypes="typeWindowsChanged|typeWindowStateChanged"
    android:accessibilityFeedbackType="feedbackGeneric"
    android:canRetrieveWindowContent="false"
    android:description="@string/service_description"
    android:isAccessibilityTool="true"
    android:notificationTimeout="100"
    android:settingsActivity="app.phueber.seniornav.MainActivity" />
