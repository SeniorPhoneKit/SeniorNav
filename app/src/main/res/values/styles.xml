<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- The family look of the Senior apps: dark text on a warm off-white page.
         The system bars take the page colour with dark icons. Content is kept
         clear of the bars in code (fitsSystemWindows). Colours used in code
         come from Palette; these match its PAGE and GREEN. -->
    <style name="AppTheme.Base" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">@color/page</item>
        <item name="android:colorAccent">@color/green</item>
        <item name="android:colorPrimary">@color/green</item>
        <item name="android:statusBarColor">@color/page</item>
        <item name="android:navigationBarColor">@color/page</item>
        <item name="android:windowLightStatusBar">true</item>
    </style>

    <style name="AppTheme" parent="AppTheme.Base" />

    <color name="page">#F4F2ED</color>
    <color name="green">#2E7D32</color>
</resources>
