<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- The bar is an accessibility overlay, which needs no permission beyond
         the helper turning the service on; no internet. -->
    <!-- A short buzz when the volume-button pattern locks or unlocks. -->
    <uses-permission android:name="android.permission.VIBRATE" />
    <!-- Lists the app under Do Not Disturb access, which the helper may grant so
         that a ring minimum can bring the ringer back from silent while locked. -->
    <uses-permission android:name="android.permission.ACCESS_NOTIFICATION_POLICY" />

    <!-- To read SeniorLauncher's shared lock, and to lock/unlock it for the volume pattern. -->
    <queries>
        <provider android:authorities="app.phueber.seniorlauncher.lock" />
    </queries>

    <application
        android:allowBackup="false"
        android:icon="@drawable/ic_launcher"
        android:label="@string/app_name"
        android:localeConfig="@xml/locales_config"
        android:supportsRtl="true"
        android:theme="@style/AppTheme"
        tools:targetApi="35">

        <!-- The helper's screen: status, switch-on steps, navigation advice. -->
        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Automation (Trigly, Tasker, ...): pause/show the bar, button sides, Back, Home,
             hide while unlocked, volume buttons, volume limits, remove the pattern.
             Exported without a permission on purpose: none of it needs one (an app can
             already send Home with an intent), see ARCHITECTURE.md, Automation. -->
        <receiver
            android:name=".AutomationReceiver"
            android:exported="true"
            tools:ignore="ExportedReceiver">
            <intent-filter>
                <action android:name="app.phueber.seniornav.action.BAR_HIDE" />
                <action android:name="app.phueber.seniornav.action.BAR_SHOW" />
                <action android:name="app.phueber.seniornav.action.BAR_SIDES" />
                <action android:name="app.phueber.seniornav.action.BAR_COLOUR" />
                <action android:name="app.phueber.seniornav.action.BACK" />
                <action android:name="app.phueber.seniornav.action.HOME" />
                <action android:name="app.phueber.seniornav.action.BAR_UNLOCKED" />
                <action android:name="app.phueber.seniornav.action.VOLUME_KEYS" />
                <action android:name="app.phueber.seniornav.action.VOLUME_LIMIT" />
                <action android:name="app.phueber.seniornav.action.PATTERN_REMOVE" />
            </intent-filter>
        </receiver>

        <!-- Whether the bar is on screen, for the other Senior apps' Back button;
             read-only, no permission (the state is visible anyway), see BarProvider. -->
        <provider
            android:name=".BarProvider"
            android:authorities="app.phueber.seniornav.bar"
            android:exported="true"
            tools:ignore="ExportedContentProvider" />

        <!-- The bar. Bound only by the system (BIND_ACCESSIBILITY_SERVICE). -->
        <service
            android:name=".NavBarService"
            android:exported="true"
            android:label="@string/app_name"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/nav_service" />
        </service>
    </application>
</manifest>
