<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- No permissions. The bar is an accessibility overlay, which needs none
         beyond the helper turning the service on; no internet. -->

    <!-- To read SeniorLauncher's shared lock (read-only). -->
    <queries>
        <provider android:authorities="app.phueber.seniorlauncher.lock" />
    </queries>

    <application
        android:allowBackup="false"
        android:icon="@drawable/ic_launcher"
        android:label="@string/app_name"
        android:localeConfig="@xml/locales_config"
        android:supportsRtl="true"
        android:theme="@style/AppTheme"
        tools:targetApi="35">

        <!-- The helper's screen: status, switch-on steps, navigation advice. -->
        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Automation (Trigly, Tasker, ...): pause/show the bar, button sides, Back, Home.
             Exported without a permission on purpose: none of it needs one (an app can
             already send Home with an intent), see ARCHITECTURE.md, Automation. -->
        <receiver
            android:name=".AutomationReceiver"
            android:exported="true"
            tools:ignore="ExportedReceiver">
            <intent-filter>
                <action android:name="app.phueber.seniornav.action.BAR_HIDE" />
                <action android:name="app.phueber.seniornav.action.BAR_SHOW" />
                <action android:name="app.phueber.seniornav.action.BAR_SIDES" />
                <action android:name="app.phueber.seniornav.action.BAR_COLOUR" />
                <action android:name="app.phueber.seniornav.action.BACK" />
                <action android:name="app.phueber.seniornav.action.HOME" />
            </intent-filter>
        </receiver>

        <!-- The bar. Bound only by the system (BIND_ACCESSIBILITY_SERVICE). -->
        <service
            android:name=".NavBarService"
            android:exported="true"
            android:label="@string/app_name"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/nav_service" />
        </service>
    </application>
</manifest>
